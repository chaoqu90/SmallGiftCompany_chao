{
  "name": "goodiebag-backend-node",
  "version": "1.0.0",
  "description": "Goodie Bag backend — Node.js 22 / TypeScript / Express on AWS Lambda",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node --env-file=.env ./node_modules/.bin/tsx watch src/server.ts",
    "build": "node esbuild.config.js",
    "lint": "eslint src --ext .ts",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "migrate": "node-pg-migrate --tsx up",
    "migrate:down": "node-pg-migrate --tsx down",
    "migrate:status": "node-pg-migrate --tsx status",
    "migrate:local": "node --env-file=.env ./node_modules/.bin/node-pg-migrate --tsx up",
    "migrate:local:down": "node --env-file=.env ./node_modules/.bin/node-pg-migrate --tsx down",
    "migrate:local:status": "node --env-file=.env ./node_modules/.bin/node-pg-migrate --tsx status",
    "cleanup-bundles": "node --env-file=.env ./node_modules/.bin/tsx scripts/cleanup-old-bundles.ts",
    "cleanup-bundles:force": "node --env-file=.env ./node_modules/.bin/tsx scripts/cleanup-old-bundles.ts --force",
    "reset-test-data": "node --env-file=.env ./node_modules/.bin/tsx scripts/reset-test-data.ts",
    "reset-test-data:force": "node --env-file=.env ./node_modules/.bin/tsx scripts/reset-test-data.ts --force",
    "import-products": "node --env-file=.env ./node_modules/.bin/tsx scripts/import-products-xlsx.ts",
    "import-products:force": "node --env-file=.env ./node_modules/.bin/tsx scripts/import-products-xlsx.ts --force",
    "upload-images": "node --env-file=.env ./node_modules/.bin/tsx scripts/upload-product-images.ts",
    "upload-images:force": "node --env-file=.env ./node_modules/.bin/tsx scripts/upload-product-images.ts --force"
  },
  "node-pg-migrate": {
    "migrationsTable": "pgmigrations",
    "dir": "migrations",
    "databaseUrlVar": "DATABASE_URL",
    "tsconfig": "tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/client-ses": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "jose": "^6.2.10",
    "postgres": "^3.4.4",
    "serverless-http": "^3.2.0",
    "stripe": "^22.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "esbuild": "^0.23.0",
    "eslint": "^8.57.0",
    "node-pg-migrate": "^7.7.0",
    "pg": "^8.12.0",
    "supertest": "^7.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5",
    "xlsx": "^0.18.5"
  }
}
