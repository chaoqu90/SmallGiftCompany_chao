# Database — Supabase transaction mode (port 6543) — REQUIRED
# Format: postgres://postgres.[project-ref]:[password]@aws-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgres://postgres.abcdefghijklmnop:yourpassword@aws-us-east-1.pooler.supabase.com:6543/postgres

# CORS — single allowed origin (not wildcard)
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Admin HTTP Basic credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Node environment
NODE_ENV=development

# Supabase Auth — JWT verification
# Find in: Supabase dashboard → Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=<paste-jwt-secret-here>

# ── Stripe Payment (FEAT-003) ────────────────────────────────────────────────
# Get from: Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
# Get from: stripe listen --forward-to http://localhost:8080/api/webhooks/stripe
# (local dev) or Stripe Dashboard → Developers → Webhooks (production)
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Email — AWS SES (FEAT-003) ───────────────────────────────────────────────
# No API key needed — uses the Lambda execution role's IAM permissions (ses:SendEmail).
# For local dev, configure AWS credentials via `aws configure` or AWS_PROFILE.
# From address — must be verified in SES (Identities) before sending.
EMAIL_FROM=orders@yourdomain.com
# AWS region where your SES identity is verified (defaults to us-east-1 if unset)
AWS_REGION=us-east-1

# Frontend URL — used in email links
FRONTEND_URL=http://localhost:5173

# ── Product Image Storage — S3 ───────────────────────────────────────────────
# S3 bucket name for product images (public read).
# Created via CloudFormation in infra/serverless.yml.
# For local dev, set to any accessible bucket name and configure AWS credentials.
PRODUCT_IMAGES_BUCKET=your-product-images-bucket-name
