# Copy this file to .env.local and fill in real values for local development.
# Never commit .env.local — it is gitignored.
#
# For CI/CD, these values are injected as environment variables during
# `npm run build` by the deploy workflow (see .github/workflows/deploy.yml).

# The URL of your Supabase project (e.g. https://xyzabc.supabase.co)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# The anon/public key for your Supabase project (safe to embed in browser JS)
VITE_SUPABASE_ANON_KEY=<anon-key>

# The API Gateway URL — set automatically during CI/CD from the backend deploy output.
# For local dev, use the local backend URL (e.g. http://localhost:8080).
VITE_API_BASE_URL=http://localhost:8080

# Stripe publishable key (safe to embed in browser JS — never use the secret key here).
# Get from: Stripe Dashboard → Developers → API keys → Publishable key.
# Use pk_test_... for local dev, pk_live_... for production.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
